node_modules/

# Secrets. .env.example is committed; .env never is.
.env
.env.local

# Per-machine secrets for setup/start-n8n.ps1. The template that generates it
# (setup/make-local-env.ps1) IS committed; the filled-in copy never is.
setup/local.env.ps1

# Dry-run artefacts. samples/sample-posts.md IS committed — it is a deliverable.
samples/generated/
samples/dry-run-state.json

# Fixtures under samples/fixtures/ ARE committed on purpose: npm test needs
# them, and a fixture made of our own assumptions would never catch PlacidWay
# changing their markup.

.DS_Store
Thumbs.db
*.log
