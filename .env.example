# PlacidWay -> Facebook daily post automation
# Copy to .env and fill in. Nothing here belongs in the workflow export.

# --- n8n -------------------------------------------------------------------
# The Config node reads these through $env, which n8n blocks by default.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Needed so the approval links in Telegram resolve to a reachable host.
WEBHOOK_URL=https://your-n8n-host.example.com/
GENERIC_TIMEZONE=Asia/Jakarta

# --- behaviour -------------------------------------------------------------
# simulate = build and log the post, never call Facebook  (default; what the
#            assessment ground rules ask for)
# schedule = create an unpublished post with scheduled_publish_time
# publish  = post live to the test Page
PW_PUBLISH_MODE=simulate

# auto     = publish as soon as both guardrail layers pass
# approval = send the draft to a reviewer and wait for a decision
PW_REVIEW_MODE=approval

# When false, any currency figure in the copy is a hard rejection.
# When true, a figure is allowed only if it matches the source page's
# JSON-LD offers.price exactly. See README, "The price decision".
PW_ALLOW_PRICE_MENTION=false

# --- limits ----------------------------------------------------------------
PW_MAX_CHARS=500
PW_MAX_ATTEMPTS=3
PW_CRAWL_DELAY_SECONDS=3
PW_CANDIDATE_LIMIT=40
PW_MIN_BODY_LENGTH=400
PW_SCHEDULE_OFFSET_MINUTES=60
PW_USER_AGENT=PlacidWayContentBot/1.0 (+https://your-contact-page.example.com)

# Force a content type instead of the weekday rotation. Leave empty normally.
# article | package
PW_FORCE_CONTENT_TYPE=

# --- model -----------------------------------------------------------------
# openai | anthropic — must match which workflow file you imported.
# "openai" means the OpenAI *wire format*, not the company: any compatible
# endpoint works. See PW_LLM_BASE_URL below.
PW_LLM_PROVIDER=openai
PW_MODEL=gpt-4o-mini

# Override the endpoint to use a different provider. All of these speak the
# OpenAI chat-completions format and take 'Authorization: Bearer <key>'.
#
#   OpenAI      https://api.openai.com/v1/chat/completions                  (paid)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/chat/completions   (free tier)
#   Groq        https://api.groq.com/openai/v1/chat/completions             (free tier)
#   OpenRouter  https://openrouter.ai/api/v1/chat/completions               (some free models)
#   Ollama      http://localhost:11434/v1/chat/completions                  (local, no key)
#
# PW_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# PW_MODEL=gemini-3.8-flash

# response_format: json_object is an OpenAI extension. Auto-enabled only for
# api.openai.com; set explicitly to override. Leaving it off is safe — the
# parser recovers JSON from fenced or prose-wrapped replies.
# PW_LLM_JSON_MODE=false

# Used by scripts/dry-run.mjs only. In n8n these live in credentials, not here.
# The first one found wins, so one file can carry several providers.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- integrations ----------------------------------------------------------
# Spreadsheet ID from the Google Sheets URL:
# docs.google.com/spreadsheets/d/<THIS_PART>/edit
PW_SHEET_ID=

# Numeric ID of YOUR test Page. Never a PlacidWay Page.
PW_FB_PAGE_ID=
PW_FB_GRAPH_VERSION=v21.0

# Telegram chat to receive drafts and failure alerts.
PW_TELEGRAM_CHAT_ID=

# n8n workflow ID of the imported error handler.
PW_ERROR_WORKFLOW_ID=
